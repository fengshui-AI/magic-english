# ============================================================
# Magic English 后端环境变量模板
# 复制此文件为 .env 并填入实际值
# ⚠️  切勿将 .env 提交到版本控制
# ============================================================

# ============================================================
# 服务配置
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# 数据库 (PostgreSQL)
# 格式: postgres://用户名:密码@主机:端口/数据库名
# 生产环境示例（腾讯云 CloudBase）:
#   postgres://user:pass@sh-postgres-xxx.sql.tencentcdb.com:24079/postgres
# 密码含特殊字符时需 URL-encode（如 @ → %40, $ → %24, # → %23）
# ============================================================
DATABASE_URL=postgres://user:password@localhost:5432/magic_english

# ============================================================
# Redis (对话状态 / 会话缓存，可选)
# 不配置时使用内存存储（仅适合开发/单实例）
# ============================================================
# REDIS_URL=redis://localhost:6379

# ============================================================
# JWT 认证
# 生产环境必须使用强随机字符串
# 生成命令：openssl rand -hex 64
# 开发环境不设置时使用固定默认值（仅限本地调试）
# ============================================================
JWT_SECRET=

# ============================================================
# CORS 白名单（逗号分隔，仅生产环境生效）
# 开发环境默认允许 localhost:5173, localhost:4173
# ============================================================
# CORS_ORIGINS=https://magic-english.your-domain.com,https://www.magic-english.your-domain.com

# ============================================================
# 语音服务 — 腾讯云 TTS / ASR / 发音评测 (SOE)
# 控制台获取密钥：https://console.cloud.tencent.com/cam/capi
# TTS 文档：https://cloud.tencent.com/document/product/1073
# ASR 文档：https://cloud.tencent.com/document/product/1093
# SOE 文档：https://cloud.tencent.com/document/product/884
# 注意：需先在控制台开通对应服务
# ============================================================
# TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TENCENT_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TENCENT_TTS_APPID=          # TTS 应用 ID（可选，部分 API 需要）
# TENCENT_SOE_APPID=          # 发音评测应用 ID（可选，部分 API 需要）

# ============================================================
# LLM 对话引擎
# 支持所有 OpenAI 兼容接口的服务商
# 推荐：Agnes AI（免费）/ 腾讯混元 / 智谱 GLM / DeepSeek / OpenAI
# ============================================================
# LLM_PROVIDER=agnes           # agnes | hunyuan | zhipu | deepseek | openai
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.agnes.ai/v1
# LLM_MODEL=agnes-1.5-flash    # 推荐用便宜的快速模型
# LLM_MAX_TOKENS=512
# LLM_TEMPERATURE=0.8

# ============================================================
# 内容安全审核（可选）
# 腾讯云内容安全 / 网易易盾
# ============================================================
# CONTENT_SECURITY_ENABLED=false
# CONTENT_SECURITY_PROVIDER=tencent
# CONTENT_SECURITY_SECRET_ID=
# CONTENT_SECURITY_SECRET_KEY=

# ============================================================
# 对象存储（音频/图片 CDN，可选）
# 腾讯云 COS
# ============================================================
# COS_BUCKET=magic-english-xxx
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=
# COS_SECRET_KEY=

# ============================================================
# 错误监控（可选）
# Sentry
# ============================================================
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================================
# 日志级别
# ============================================================
# LOG_LEVEL=info               # debug | info | warn | error
