# ============================================================
# Magic English 后端环境变量模板
# 复制此文件为 .env 并填入实际值
# ⚠️  切勿将 .env 提交到版本控制
# ============================================================

# ============================================================
# 服务配置
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# 数据库 (PostgreSQL)
# ============================================================
DATABASE_URL=postgres://user:password@localhost:5432/magic_english

# ============================================================
# Redis (对话状态 / 会话缓存)
# ============================================================
# REDIS_URL=redis://localhost:6379

# ============================================================
# JWT 认证
# ============================================================
# 生产环境必须使用强随机字符串（生成命令：openssl rand -hex 64）
# 开发环境不设置时会使用固定默认值（仅限本地调试）
JWT_SECRET=

# ============================================================
# CORS 白名单（逗号分隔）
# ============================================================
# 开发环境默认允许 localhost:5173, localhost:4173
# 生产环境必须显式设置
# CORS_ORIGINS=https://magic-english.your-domain.com

# ============================================================
# 语音服务 — 腾讯云 TTS / ASR / 发音评测
# ============================================================
# 控制台：https://console.cloud.tencent.com/cam/capi
# TTS 文档：https://cloud.tencent.com/document/product/1073
# ASR 文档：https://cloud.tencent.com/document/product/1093
# SOE 文档：https://cloud.tencent.com/document/product/884
# TENCENT_SECRET_ID=your-secret-id
# TENCENT_SECRET_KEY=your-secret-key
# TENCENT_TTS_APPID=your-appid
# TENCENT_SOE_APPID=your-soe-appid

# ============================================================
# LLM 对话引擎
# ============================================================
# 支持 OpenAI 兼容接口（腾讯混元 / 智谱 GLM / DeepSeek 等）
# LLM_PROVIDER=hunyuan                        # 可选：hunyuan | zhipu | deepseek | openai
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbos-latest             # 推荐用便宜的快速模型
# LLM_MAX_TOKENS=512
# LLM_TEMPERATURE=0.8

# ============================================================
# 内容安全审核（可选）
# ============================================================
# 腾讯云内容安全 / 网易易盾
# CONTENT_SECURITY_ENABLED=false
# CONTENT_SECURITY_PROVIDER=tencent
# CONTENT_SECURITY_SECRET_ID=
# CONTENT_SECURITY_SECRET_KEY=

# ============================================================
# 对象存储（音频/图片 CDN，可选）
# ============================================================
# COS_BUCKET=magic-english-xxx
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=
# COS_SECRET_KEY=

# ============================================================
# 错误监控（可选）
# ============================================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
