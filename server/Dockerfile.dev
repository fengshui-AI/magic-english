# Magic English — 后端开发 Dockerfile
# 用于 docker compose 本地开发环境，支持热更新
FROM node:22-alpine

WORKDIR /app

# 安装系统依赖（pg_isready 用于健康检查）
RUN apk add --no-cache postgresql-client

# 复制 package 文件并安装依赖
COPY package.json package-lock.json* ./
RUN npm install

# 复制 tsconfig 和 drizzle 配置
COPY tsconfig.json drizzle.config.ts ./
COPY vitest.config.ts ./

# 确保 node_modules 包含 tsx 和 drizzle-kit
RUN npx --yes tsx --version

EXPOSE 3000

CMD ["node", "--watch", "--import", "tsx", "src/index.ts"]
