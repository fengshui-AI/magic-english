# ============================================================
# Magic English 前端环境变量模板
# 复制此文件为 .env 并填入实际值
# ⚠️  切勿将 .env 提交到版本控制
# ============================================================

# ============================================================
# 基础配置
# ============================================================
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws
VITE_APP_NAME=豆语星球
VITE_APP_VERSION=1.0.0

# ============================================================
# 第三方服务（生产环境按需配置）
# ============================================================

# Sentry DSN（错误监控）
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# 腾讯云 COS（音频/图片上传）
# VITE_COS_BUCKET=magic-english-xxx
# VITE_COS_REGION=ap-guangzhou

# 内容安全审核开关
# VITE_CONTENT_SECURITY_ENABLED=false
