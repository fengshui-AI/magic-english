/** 手账本样式 */

.stats-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 16rpx 0;
}

.filter-bar {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 24rpx;
}

.filter-item {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
}

.filter-item.active {
  background: var(--color-accent);
  color: #fff;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.word-card {
  width: calc(50% - 8rpx);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-word {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-accent-light);
  margin-bottom: 8rpx;
}

.card-meaning {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.empty-icon {
  font-size: 80rpx;
}
