/** 手账本样式 */

.stats-bar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 16rpx 0;
}

.filter-bar {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 24rpx;
}

.filter-item {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
}

.filter-item.active {
  background: var(--color-accent);
  color: #fff;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.word-card {
  position: relative;
  width: calc(50% - 8rpx);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 40rpx 20rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
}

/* 稀有度边框 + 微光 */
.word-card.rarity-common {
  border-color: rgba(139, 139, 167, 0.25);
}
.word-card.rarity-rare {
  border-color: rgba(124, 92, 231, 0.55);
  box-shadow: 0 0 16rpx rgba(124, 92, 231, 0.25);
}
.word-card.rarity-epic {
  border-color: rgba(251, 191, 36, 0.65);
  box-shadow: 0 0 18rpx rgba(251, 191, 36, 0.28);
}

/* 稀有度徽章 */
.card-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-full);
  color: #fff;
}
.card-badge.rarity-common {
  background: rgba(139, 139, 167, 0.35);
  color: var(--color-text-secondary);
}
.card-badge.rarity-rare {
  background: var(--color-accent);
}
.card-badge.rarity-epic {
  background: var(--color-warning);
  color: #3a2c00;
}

.card-word {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-accent-light);
  margin-bottom: 8rpx;
}

.card-meaning {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}
