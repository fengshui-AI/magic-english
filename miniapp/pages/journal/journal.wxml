<!-- 手账本页 -->
<view class="container">
  <!-- 顶部统计 -->
  <view class="stats-bar">
    <text class="text-xs text-secondary">共 {{stats.total}} 张卡牌</text>
    <text class="text-xs text-accent">稀有 {{stats.rare}}</text>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <text
      class="filter-item {{filter === 'all' ? 'active' : ''}}"
      data-filter="all"
      bindtap="handleFilter"
    >全部</text>
    <text
      class="filter-item {{filter === 'common' ? 'active' : ''}}"
      data-filter="common"
      bindtap="handleFilter"
    >普通</text>
    <text
      class="filter-item {{filter === 'rare' ? 'active' : ''}}"
      data-filter="rare"
      bindtap="handleFilter"
    >稀有</text>
    <text
      class="filter-item {{filter === 'epic' ? 'active' : ''}}"
      data-filter="epic"
      bindtap="handleFilter"
    >史诗</text>
  </view>

  <!-- 卡牌网格 -->
  <view class="card-grid" wx:if="{{cards.length > 0}}">
    <view
      wx:for="{{cards}}"
      wx:key="id"
      class="word-card"
      data-index="{{index}}"
      bindtap="handleCardTap"
    >
      <text class="card-word">{{item.word}}</text>
      <text class="card-meaning">{{item.meaning}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📖</text>
    <text class="text-md text-secondary mt-md">还没有收集到单词卡牌</text>
    <text class="text-sm text-muted mt-sm">去学习页和豆豆一起学英语吧！</text>
  </view>
</view>
