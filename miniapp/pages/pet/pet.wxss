/** 宠物家园样式 */

.dodo-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.dodo-emoji {
  font-size: 140rpx;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.dodo-name {
  margin-top: 24rpx;
}

.exp-bar {
  width: 80%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.exp-fill {
  height: 100%;
  background: linear-gradient(90deg, #f7c948, #fbbf24);
  border-radius: var(--radius-full);
  transition: width 0.5s;
}

.actions {
  width: 60%;
  display: flex;
  flex-direction: column;
}
