/** 登录页样式 */

.container {
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #0f0f23 0%, #1a1a2e 50%, #16213e 100%);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  filter: drop-shadow(0 0 40rpx rgba(124, 92, 231, 0.3));
}

.title {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.login-actions {
  width: 100%;
  max-width: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 100%;
  padding: 28rpx 0;
  font-size: 34rpx;
}

.error-msg {
  margin-top: 24rpx;
  color: var(--color-error);
}

.footer-text {
  position: absolute;
  bottom: 80rpx;
  color: var(--color-text-muted);
}
