<!-- 登录页 -->
<view class="container flex-col flex-center">
  <!-- Logo 区域 -->
  <view class="logo-area">
    <view class="logo-icon">🪐</view>
    <text class="title">豆语星球</text>
    <text class="subtitle">每天10分钟，和豆豆说英语</text>
  </view>

  <!-- 登录按钮 -->
  <view class="login-actions">
    <button
      class="btn btn-primary login-btn"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="handleLogin"
    >
      微信一键登录
    </button>

    <!-- 错误提示 -->
    <text class="error-msg text-error text-sm" wx:if="{{errorMsg}}">
      {{errorMsg}}
    </text>
  </view>

  <!-- 底部版权 -->
  <text class="footer-text text-muted text-xs">豆语星球 · 儿童英语陪伴</text>
</view>
