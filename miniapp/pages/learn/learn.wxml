<!-- 学习页 - 核心对话界面 -->
<view class="container">
  <!-- 顶部：无数字情感化标识（遵守 PRD 4.7 永不展示数字） -->
  <text class="chat-title text-xs text-secondary text-center">
    和豆豆一起聊天中 🐣
  </text>

  <!-- 对话区域 -->
  <scroll-view class="chat-area" scroll-y scroll-into-view="msg-{{messages.length - 1}}">
    <view
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
      class="msg {{item.role}}"
    >
      <text class="msg-avatar">{{item.role === 'dodo' ? '🐣' : '👦'}}</text>
      <view class="msg-bubble {{item.role}}">
        <text>{{item.text}}</text>
        <text wx:if="{{item.translation}}" class="msg-translation">{{item.translation}}</text>
        <!-- 豆豆回复的朗读喇叭 -->
        <view
          wx:if="{{item.role === 'dodo'}}"
          class="msg-speaker {{item.playing ? 'playing' : ''}}"
          catchtap="handlePlayVoice"
          data-index="{{index}}"
        >
          <text>{{item.playing ? '🔊' : '🔈'}}</text>
        </view>
      </view>
    </view>

    <!-- 豆豆思考中 -->
    <view wx:if="{{thinking}}" class="msg dodo" id="msg-thinking">
      <text class="msg-avatar">🐣</text>
      <view class="msg-bubble dodo">
        <text class="thinking-dots">豆豆在想…</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="input-bar">
    <!-- 语音按钮 -->
    <view class="voice-btn {{recording ? 'recording' : ''}}" bindtap="handleRecord">
      <text>🎤</text>
    </view>

    <!-- 文字输入 -->
    <input
      class="text-input"
      placeholder="和豆豆聊天…"
      value="{{inputValue}}"
      bindinput="handleInput"
      confirm-type="send"
      bindconfirm="handleSend"
      auto-focus
    />

    <!-- 发送按钮 -->
    <view class="send-btn" bindtap="handleSend">
      <text>发送</text>
    </view>
  </view>
</view>
