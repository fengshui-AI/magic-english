/** 学习页样式 */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.1);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-accent), var(--color-accent-light));
  transition: width 0.3s;
}

.progress-text {
  display: block;
  padding: 12rpx 0;
  text-align: center;
}

/* 对话区域 */
.chat-area {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.msg {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg.dodo {
  flex-direction: row;
}

.msg.user {
  flex-direction: row-reverse;
}

.msg-avatar {
  font-size: 40rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-bubble {
  max-width: 70%;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-lg);
  margin: 0 12rpx;
}

.msg.dodo .msg-bubble {
  background: var(--color-bg-card);
  border-top-left-radius: 4rpx;
}

.msg.user .msg-bubble {
  background: linear-gradient(135deg, var(--color-accent), #6c4fd8);
  border-top-right-radius: 4rpx;
  color: #fff;
}

/* 输入栏 */
.input-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-bg-secondary);
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  gap: 16rpx;
}

.voice-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  flex-shrink: 0;
}

.voice-btn.recording {
  background: var(--color-error);
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.text-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-full);
  padding: 0 24rpx;
  font-size: var(--font-md);
  color: var(--color-text-primary);
}

.send-btn {
  padding: 12rpx 24rpx;
  background: var(--color-accent);
  color: #fff;
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  flex-shrink: 0;
}
