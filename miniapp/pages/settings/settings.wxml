<!-- 设置页 -->
<view class="container">
  <text class="text-lg text-bold mb-md">设置</text>

  <!-- 学习设置 -->
  <view class="section">
    <text class="text-sm text-secondary mb-sm">学习设置</text>
    <view class="card">
      <view class="flex-between">
        <text>每日单词目标</text>
        <text class="text-accent">{{dailyWordTarget}} 个</text>
      </view>
      <slider
        class="mt-sm"
        min="1"
        max="10"
        value="{{dailyWordTarget}}"
        bindchange="handleWordTargetChange"
        activeColor="#7c5ce7"
      />
    </view>
  </view>

  <!-- 通用设置 -->
  <view class="section mt-md">
    <text class="text-sm text-secondary mb-sm">通用</text>
    <view class="card">
      <view class="flex-between">
        <text>音效</text>
        <switch
          checked="{{soundEnabled}}"
          bindchange="handleSoundToggle"
          color="#7c5ce7"
        />
      </view>
    </view>
  </view>

  <!-- 账户 -->
  <view class="section mt-md">
    <text class="text-sm text-secondary mb-sm">账户</text>
    <view class="card" bindtap="handleLogout">
      <text class="text-error">退出登录</text>
    </view>
  </view>

  <!-- 版本 -->
  <text class="version text-xs text-muted text-center mt-lg">豆语星球 v{{version}}</text>
</view>
